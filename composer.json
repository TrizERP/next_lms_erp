{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "aws/aws-sdk-php": "^3.298",
        "barryvdh/laravel-dompdf": "^3.0",
        "botman/botman": "^2.8",
        "botman/driver-slack": "^1.0",
        "botman/driver-web": "^1.5",
        "dompdf/dompdf": "^3.0",
        "generationtux/jwt-artisan": "^2.0",
        "google/cloud-language": "^0.11.2",
        "guzzlehttp/guzzle": "^7.9",
        "inspector-apm/inspector-laravel": "^4.19",
        "intervention/image": "^3.7",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.8",
        "laudis/neo4j-php-client": "^3.2",
        "league/flysystem-aws-s3-v3": "^3.15",
        "livewire/livewire": "^3.0",
        "maatwebsite/excel": "^3.1",
        "mews/captcha": "^3.5",
        "opcodesio/log-viewer": "^3.0",
        "openai-php/client": "^0.10.1",
        "phpmailer/phpmailer": "^6.7",
        "phpoffice/phppresentation": "^1.1",
        "picqer/php-barcode-generator": "^2.2",
        "razorpay/razorpay": "^2.8",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "smalot/pdfparser": "^2.11",
        "spatie/async": "^1.6",
        "twilio/sdk": "^8.0",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "filp/whoops": "^2.14",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "files": [
            "app/Helpers/Helper.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "disable-tls": true,
        "secure-http": false,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
