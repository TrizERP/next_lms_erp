#--------------------------------------------------------------------------
# Conversational AI — the model provider
#--------------------------------------------------------------------------
#
# One driver is active at a time and it owns the only model key this
# application needs. Set AI_PROVIDER, then fill in that driver's key and leave
# the others empty: a key for an inactive driver is never read, and having
# three of them is how an estate ends up unsure which one is actually paying.
#
# gemini | openrouter | deepseek
AI_PROVIDER=gemini

# The active driver's key. Fill in exactly one block.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Browser origins allowed to call this API (comma-separated). Replaces the old
# wildcard in config/cors.php. Leave unset to use the built-in defaults
# (lms-k12.vercel.app, dev.triz.co.in, localhost:3000).
CORS_ALLOWED_ORIGINS=
# Regex list for generated hostnames, e.g. Vercel preview deployments.
CORS_ALLOWED_ORIGIN_PATTERNS=

# Per-user spend cap on POST /api/intelligence/questions/generate. One run can
# be ~17 sequential DeepSeek calls, so this is a cost control.
DEEPSEEK_RATE_LIMIT_ATTEMPTS=5
DEEPSEEK_RATE_LIMIT_DECAY_MINUTES=1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_REQUEST_TIMEOUT=45
# GEMINI_MAX_OUTPUT_TOKENS=1466

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT=45
# OPENROUTER_MAX_OUTPUT_TOKENS=1466

#--------------------------------------------------------------------------
# Conversational AI — the governed lifecycle
#--------------------------------------------------------------------------
#
# AI_LIFECYCLE_ENABLED is the cutover switch. While it is false /ask uses the
# previous service; while true the same endpoint runs the twelve-stage
# pipeline. Both write to the same tables, so it can be turned on and off
# without stranding a conversation.
AI_LIFECYCLE_ENABLED=false
AI_ROUTE_PREFIX=api/ai
AI_RATE_LIMIT_PER_MINUTE=60

# How long a drafted recommendation stays actionable, and how long the human
# approval gate waits before a pending decision is considered stale.
AI_RECOMMENDATION_TTL_DAYS=30
AI_APPROVAL_TTL_HOURS=168

# Text generation (templates, drafted activities). Separate from AI_PROVIDER
# because generation and conversation may legitimately run on different models.
AI_GENERATION_PROVIDER=openrouter
AI_GENERATION_MODEL=deepseek/deepseek-chat
AI_GENERATION_TIMEOUT=45

# Knowledge-graph traversal limits.
AI_KG_PREFER_GRAPH=true
AI_KG_MAX_DEPTH=4
AI_KG_DEFAULT_LIMIT=25

#--------------------------------------------------------------------------
# MCP server
#--------------------------------------------------------------------------
#
# This application is the MCP server: it publishes the tools, and every client
# — the assistant panel included — reaches the estate through it.
MCP_ROUTE_PREFIX=api/mcp
MCP_SERVER_NAME="${APP_NAME}"
MCP_SERVER_VERSION=1.0.0
MCP_RATE_LIMIT_PER_MINUTE=60

# Empty accepts every protocol version the installed server supports; set a
# comma-separated list to pin.
MCP_PROTOCOL_VERSIONS=

# How long a confirmation token for a consequential tool stays spendable. This
# is the window between "here is what I am about to do" and a human saying yes.
MCP_CONFIRMATION_TTL_MINUTES=10

# Deprecation headers served by the compatibility REST shim.
MCP_REST_SUNSET=2027-03-01
MCP_REST_SUCCESSOR=/api/mcp
MCP_REST_DOCS=https://modelcontextprotocol.io/specification

#--------------------------------------------------------------------------
# Legacy model keys — not part of the contract above
#--------------------------------------------------------------------------
#
# Still read by older call sites (lms content generation and the PAL content
# model), which have not moved to the AI_PROVIDER block. Do not add new
# consumers; new work goes through the driver above.
GOOGLE_API_KEY=
OPENAI_API_KEY=
